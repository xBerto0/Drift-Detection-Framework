# =============================================================================
# drift_framework — Configurazione degli esperimenti
# =============================================================================
# Modificare questi valori per cambiare i parametri usati dagli script
# experiment_*.py senza toccare il codice.
#
# Questo file NON contiene segreti: sono solo parametri di configurazione
# degli esperimenti, quindi va committato in repo per garantire la
# riproducibilita' dei risultati.
# =============================================================================


# --- Dataset ---
DATASET_ELEC2_PATH=data/electricity-normalized.csv


# --- Esperimento Bernoulli sintetico ---
BERNOULLI_N_SAMPLES=1000
BERNOULLI_DRIFT_POINT=500
BERNOULLI_SEED=42


# --- Esperimento ELEC2 ---
ELEC2_TRAIN_SIZE=500


# --- Strategia KS (Kolmogorov-Smirnov) ---
KS_WINDOW_SIZE=100
KS_ALPHA=0.05


# --- Strategia ADWIN ---
ADWIN_DELTA=0.002


# --- FeatureDriftDetector ---
# Numero minimo di feature drittate perche' venga dichiarato drift globale
FEATURE_K_THRESHOLD=1


# --- Strategia DDM (Drift Detection Method, Gama et al. 2004) ---
# warm_start: numero di campioni prima che il test si attivi.
# Il default di river e' 30, ma i test multi-seed mostrano falsi allarmi
# precoci con quel valore (baseline stimata su troppi pochi campioni).
# Con 200 i falsi allarmi spariscono senza penalizzare la latenza.
DDM_WARM_START=200
DDM_WARNING_THRESHOLD=2.0
DDM_DRIFT_THRESHOLD=3.0


# --- Strategia Page-Hinkley (Page 1954) ---
# Usata sugli stream continui, in particolare l'errore assoluto di un
# modello di regressione. mode=up perche' dell'errore interessa la crescita.
PH_MIN_INSTANCES=30
PH_DELTA=0.005
PH_THRESHOLD=50.0
PH_ALPHA=0.9999
PH_MODE=up


# --- Dataset Friedman (regressione con drift) ---
DATASET_FRIEDMAN_LEA_PATH=data/friedman_lea.csv
DATASET_FRIEDMAN_GRA_PATH=data/friedman_gra.csv
DATASET_FRIEDMAN_GSG_PATH=data/friedman_gsg.csv
FRIEDMAN_TRAIN_SIZE=1000


# --- Servizio di monitoring ---
# Il .env e' un formato piatto chiave=valore e non puo' contenere la struttura
# annidata "tipo di drift -> lista di strategie". Tiene quindi il percorso del
# file di configurazione vero e proprio, che e' in JSON.
DRIFT_CONFIG_PATH=config/drift_config_drift.json
