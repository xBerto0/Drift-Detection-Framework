{
  "input": {
    "reference": "data/demo/riferimento.csv",
    "current": "data/demo/corrente.csv",
    "target_column": "class",
    "model_path": "models/addestrati/classificatore_elec2.pkl"
  },

  "drift_da_rilevare": {
    "data_drift":       ["ks", "adwin"],
    "prediction_drift": ["adwin", "page_hinkley"],
    "concept_drift":    ["ddm", "adwin", "page_hinkley"]
  },

  "parametri": {
    "ks":           { "window_size": 200, "alpha": 0.05 },
    "adwin":        { "delta": 0.002 },
    "ddm":          { "warm_start": 200 },
    "page_hinkley": { "mode": "up", "threshold": 50.0 }
  },

  "correzione_test_multipli": "bonferroni",
  "aggregazione": "or"
}
